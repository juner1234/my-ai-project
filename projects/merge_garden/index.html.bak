const KEY='flowerTownV2Final';
let S=loadState();
if(!S.decorBag)S.decorBag={flowerbed:1,vine:1,path:1};if(S.version<12){S.maxEnergy=200;S.version=12;save()} if(!S.npcSchedule)S.npcSchedule={day:"",events:[]}; if(!S.npcStory)S.npcStory={}; if(!S.research)S.research={points:0,studied:[],mutations:[]}; if(!S.npcSchedule.visits)S.npcSchedule.visits=[];
function fresh(){let board=Array(25).fill(null);[0,2,4,6].forEach(i=>board[i]=1);return {version:12,coins:120,energy:100,maxEnergy:200,board,bag:{'tool:energyBottle':2},discovered:['f1'],recipes:[],creatures:[],treasures:[],decorUnlocked:['flowerbed','vine','path'],decorBag:{flowerbed:1,vine:1,path:1},home:Array(25).fill(null),eco:{beauty:3,flower:2,water:0,forest:0,honey:0,night:0},tasks:[],tasksCollapsed:false,completedTasks:0,explore:5,exploreMax:5,lastExploreAt:Date.now(),eventDay:'',event:null,bagCap:30,music:true,flowerXp:0,exploreXp:0,ecoXp:0,reputation:0,npcTrust:{},npcSchedule:{day:"",events:[]},npcStory:{},achievements:[],locked:true,energyTick:0,lastEnergyAt:Date.now(),playStartAt:Date.now(),activeMilestones:[],research:{points:0,studied:[],mutations:[]},homeYield:{dew:0,honey:0,moon:0,dust:0},lastEcoTick:Date.now(),ecoHarvested:0,loginDay:'',loginClaimed:false,shopDay:'',shopEnergyBuys:0,treasuresOpened:0};}
function loadState(){try{let old=JSON.parse(localStorage.getItem(KEY)||'null');let n=Object.assign(fresh(),old||{}); if(!n.maxEnergy)n.maxEnergy=90; if(n.energy==null)n.energy=40; if(!n.lastEnergyAt)n.lastEnergyAt=Date.now(); if(!n.playStartAt)n.playStartAt=Date.now(); if(n.tasksCollapsed==null)n.tasksCollapsed=false; if(!n.research)n.research={points:0,studied:[],mutations:[]}; return n}catch(e){return fresh()}}
function recoverEnergy(){let now=Date.now(),last=Number(S.lastEnergyAt)||now,tick=120000;if(S.energy>=S.maxEnergy){S.lastEnergyAt=now;return false}let elapsed=Math.max(0,now-last),gained=Math.floor(elapsed/tick);if(gained>0){let before=S.energy;S.energy=Math.min(S.maxEnergy,S.energy+gained);S.lastEnergyAt=last+gained*tick;if(S.energy>=S.maxEnergy)S.lastEnergyAt=now;return S.energy>before}return false}
function energyTimer(){recoverEnergy();let now=Date.now(),tick=120000,remaining=Math.max(0,tick-(now-(Number(S.lastEnergyAt)||now)));let el=document.getElementById('energy');let tm=document.getElementById('energyTimer');if(el)el.title=S.energy>=S.maxEnergy?'自然恢复已满；奖励体力可突破200':'自然恢复：每2分钟 +1⚡';if(tm)tm.textContent=S.energy>=S.maxEnergy?'已满':String(Math.floor(remaining/60000)).padStart(2,'0')+':'+String(Math.ceil((remaining%60000)/1000)).padStart(2,'0')}
function grantEnergy(n,reason=''){S.energy+=n;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();toast('⚡ '+reason+' +'+n+'体力');save();renderAll()}
function addRewardEnergy(n,reason=''){grantEnergy(n,reason)}
function save(){localStorage.setItem(KEY,JSON.stringify(S))}
function today(){let d=new Date();return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()}
function rand(a){return a[Math.floor(Math.random()*a.length)]}
function toast(t){let e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(window._toast);window._toast=setTimeout(()=>e.classList.remove('show'),1700)}
function setView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===v));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.view===v));renderAll()}
document.querySelectorAll('.tab').forEach(x=>x.onclick=()=>setView(x.dataset.view));
function imgFor(f){return f.img}
function flowerByLv(lv){return FLOWERS[lv-1]}
function renderBoard(){let g=document.getElementById('grid');g.innerHTML='';S.board.forEach((lv,i)=>{let c=document.createElement('div');c.className='cell';c.dataset.i=i;if(lv){let f=flowerByLv(lv),im=document.createElement('img');im.className='item';im.draggable=false;im.src=f.img;im.alt=f.name;im.onerror=()=>{im.remove();c.insertAdjacentHTML('afterbegin',`<span style="font-size:32px">${f.emoji}</span>`)};let tag=document.createElement('span');tag.className='lv';tag.textContent='Lv.'+lv;c.append(im,tag);c.onpointerdown=e=>dragStart(e,i)}g.append(c)});}
function dragStart(e,from){e.preventDefault();let move=ev=>{document.querySelectorAll('.cell').forEach(x=>x.classList.remove('target'));let c=document.elementFromPoint(ev.clientX,ev.clientY)?.closest('.cell');if(c)c.classList.add('target')};let up=ev=>{let c=document.elementFromPoint(ev.clientX,ev.clientY)?.closest('.cell');document.querySelectorAll('.cell').forEach(x=>x.classList.remove('target'));let to=c?+c.dataset.i:-1;if(to>=0&&to!==from)moveItem(from,to);removeEventListener('pointermove',move);removeEventListener('pointerup',up)};addEventListener('pointermove',move);addEventListener('pointerup',up,{once:true})}
function moveItem(a,b){if(!S.board[a])return;if(!S.board[b]){S.board[b]=S.board[a];S.board[a]=null;save();renderAll();return}if(S.board[a]===S.board[b]&&S.board[a]<9){let old=S.board[a];S.board[b]++;S.board[a]=null;S.coins+=5;S.flowerXp+=old*2;discover('f'+S.board[b]);maybeSpecial(old,S.board[b]);taskProgress('merge');checkAchievements();toast('✨ '+flowerByLv(S.board[b]).name+'！ +5🪙');save();renderAll()}else toast('💗 需要相同等级的花朵')}
function maybeSpecial(old,newLv){let e=S.event;if(e==='growth'&&Math.random()<.25){S.energy+=1;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();toast('🌱 生长潮！额外 +1⚡')}if(newLv>=5&&Math.random()<.12){let ids=['dew','honey','moon'];let m=rand(ids);addBag('mat:'+m,1);toast(MATERIALS[m].emoji+' 发现了特殊材料！')}if(newLv>=7&&Math.random()<.04){addBag('mat:dust',1);toast('✨ 高阶花朵引来了星尘！')}}
function addBag(k,n=1){S.bag[k]=(S.bag[k]||0)+n;if(S.bag[k]<=0)delete S.bag[k]}
function bagCount(){return Object.keys(S.bag).filter(k=>(S.bag[k]||0)>0).length}
function discover(id){if(!S.discovered.includes(id)){S.discovered.push(id);toast('📖 新发现：'+(FLOWERS.find(x=>x.id===id)?.name||'未知'))}}
function spawn(){recoverEnergy();if(S.energy<1){toast('⚡ 体力不足，看看任务/商店吧');return false}let empty=S.board.map((x,i)=>x?null:i).filter(x=>x!==null);if(!empty.length){toast('🌸 花园满啦');return false}let wasFull=S.energy>=S.maxEnergy;S.energy--;if(wasFull)S.lastEnergyAt=Date.now();S.spawnCount=(S.spawnCount||0)+1;S.board[rand(empty)]=1;if(S.spawnCount%8===0)grantEnergy(8,'连续采集奖励');if(S.spawnCount%20===0)grantEnergy(20,'活跃里程碑');toast('🌱 花芽出现啦');save();renderAll();return true}
function sortBoard(){let a=S.board.filter(Boolean).sort((x,y)=>x-y);S.board=Array(25).fill(null);a.forEach((x,i)=>S.board[i]=x);save();renderAll();toast('🧹 整理完成')}
function openSpecial(){let html='<div class="list">';SPECIAL.forEach(s=>{let a=S.bag['flower:'+s.need[0].replace('f','')]|0,m=s.need[1],mc=S.bag['mat:'+m]|0;html+=`<div class="row"><span class="big">${s.emoji}</span><main><b>${s.name} · ${'★'.repeat(s.rarity)}</b><p>${FLOWERS.find(f=>f.id===s.need[0])?.name||''} + ${MATERIALS[m]?.name||'特殊条件'} · ${s.effect}</p></main><button class="btn" data-craft="${s.id}">合成</button></div>`});html+='</div>';showModal('✨ 特殊合成',html);document.querySelectorAll('[data-craft]').forEach(b=>b.onclick=()=>craft(b.dataset.craft))}
function craft(id){let s=SPECIAL.find(x=>x.id===id),lv=+s.need[0].slice(1),m=s.need[1];if((S.bag['flower:'+lv]||0)<1||(S.bag['mat:'+m]||0)<1)return toast('材料还不够哦');addBag('flower:'+lv,-1);addBag('mat:'+m,-1);let success=true;if(success){addBag('special:'+id,1);if(!S.recipes.includes(id))S.recipes.push(id);if(!S.discovered.includes(id))S.discovered.push(id);toast('🌟 发现特殊花：'+s.name)}else{addBag('flower:'+Math.min(9,lv+1),1);toast('✨ 发生变异，得到意外花朵')}save();closeModal();renderAll()}
function itemRule(id){return ITEM_RULES[id]||null}
function itemDetail(key){
 let type='',name='',emoji='',rarity=1,source='',use='',eco={},likes='',time='',combo='',result='';
 if(key.startsWith('special:')){let id=key.slice(8),x=SPECIAL.find(a=>a.id===id),r=itemRule(id);if(!x)return;type='神秘花';name=x.name;emoji=x.emoji;rarity=x.rarity;source=r.source;use=r.use;eco=r.eco;likes=r.likes;time=r.time;combo=r.combo;result=r.result}
 else if(key.startsWith('mat:')){let id=key.slice(4),x=MATERIALS[id];if(!x)return;name=x.name;emoji=x.emoji;rarity=x.rarity;let map={dew:['水域探索、雨天事件、NPC','用于水系特殊合成'],moon:['夜间探索、月光事件、NPC','用于夜系特殊合成'],dust:['星路探索、流星雨、NPC','用于星辉类合成与神秘钥匙'],honey:['花香探索、蜜蜂事件、NPC','用于蜜源类合成'],rainbow:['彩虹事件、星路探索','用于彩虹花与高阶合成'],life:['森林生态、特殊探索','用于生命系合成'],ice:['雪原探索','用于冰系合成'],seed:['神秘事件、后期探索','世界级隐藏材料']}[id]||['探索获得','特殊材料'];source=map[0];use=map[1]}
 else if(key.startsWith('flower:')){let f=flowerByLv(+key.slice(7));if(!f)return;name=f.name;emoji=f.emoji;rarity=f.rarity;source=f.lv===1?'采集/商店/任务':'相同等级花朵合成';use=f.lv<8?'继续合成、订单、任务':'高阶合成、收藏';}
 else if(key.startsWith('tool:')){let id=key.slice(5),x=TOOLS[id];if(!x)return;name=x.name;emoji=x.emoji;source='商店、兑换、任务或宝箱';use=x.desc}
 let ecoHtml=Object.keys(eco).length?Object.entries(eco).map(([k,v])=>(ECO_INFO[k]?.[0]||k)+' +'+v).join(' · '):'—';
 showModal(emoji+' '+name,`<div class="detail-grid"><div class="detail-card"><b>⭐ 稀有度</b>${'★'.repeat(rarity)}</div><div class="detail-card"><b>📍 获取来源</b>${source}</div><div class="detail-card"><b>✨ 用途</b>${use}</div><div class="detail-card"><b>🏡 家园生态</b>${ecoHtml}</div><div class="detail-card"><b>🐾 偏好/吸引</b>${likes||'—'}</div><div class="detail-card"><b>🌙 时间/环境</b>${time||'—'}</div><div class="detail-card"><b>🔗 组合效果</b>${combo||'—'}</div><div class="detail-card"><b>🎁 特殊结果</b>${result||'—'}</div></div>`)
}
function renderInventory(){let e=document.getElementById('inventory');let entries=[];for(let i=1;i<=9;i++)if(S.bag['flower:'+i])entries.push([flowerByLv(i).emoji,flowerByLv(i).name,S.bag['flower:'+i],'flower:'+i]);for(let k in S.bag){if(k.startsWith('mat:')){let m=k.slice(4);if(MATERIALS[m])entries.push([MATERIALS[m].emoji,MATERIALS[m].name,S.bag[k],k])}if(k.startsWith('special:')){let s=SPECIAL.find(x=>x.id===k.slice(8));if(s)entries.push([s.emoji,s.name,S.bag[k],k])}if(k.startsWith('tool:')){let t=TOOLS[k.slice(5)];if(t)entries.push([t.emoji,t.name,S.bag[k],k])}if(k.startsWith('treasure:')){let id=k.slice(9),nm=id==='rare'?'稀有宝箱':'普通宝箱',em=id==='rare'?'💎':'🎁';entries.push([em,nm,S.bag[k],k])}}if(!entries.length)entries=[['🌱','背包还很空','','']];e.innerHTML=entries.slice(0,25).map(x=>`<div class="slot" onclick="${x[3]&&x[3].startsWith('tool:')?`useTool('${x[3].slice(5)}')`:`itemDetail('${x[3]}')`}" style="cursor:pointer"><span class="ico">${x[0]}</span>${x[1]}<br><small>×${x[2]}</small><br><small>点击查看用途</small></div>`).join('');document.getElementById('bagCap').textContent=bagCount()+'/'+S.bagCap}
function upgradeBag(){let levels=[[40,300],[50,800],[65,1500],[80,3000],[100,6000],[125,12000]];let x=levels.find(v=>v[0]>S.bagCap);if(!x)return toast('🎒 已达到当前上限');if(S.coins<x[1])return toast('🪙 金币不够');S.coins-=x[1];S.bagCap=x[0];save();renderAll();toast('🎒 背包升级到 '+x[0]+' 格')}
function resetTasks(){if(S.tasksDay===today()&&S.tasks.length)return;S.tasksDay=today();S.tasks=[{id:'merge',text:'完成 3 次合成',p:0,max:3,reward:35,energy:10},{id:'collect',text:'获得 3 个花芽',p:0,max:3,reward:30,energy:10},{id:'explore',text:'探索 1 次',p:0,max:1,reward:45,energy:12}];S.loginClaimed=false;S.shopDay=today();S.shopEnergyBuys=0;save()}
function taskProgress(id,n=1){let t=S.tasks.find(x=>x.id===id);if(t&&!t.done){t.p=Math.min(t.max,t.p+n);if(t.p>=t.max){t.done=true;S.coins+=t.reward;S.completedTasks++;let before=S.energy;S.energy=Math.min(S.maxEnergy,S.energy+(t.energy||0));S.lastEnergyAt=Date.now();toast('🎁 任务完成！ +'+t.reward+'🪙 +'+(S.energy-before)+'⚡')}}}
function renderTasks(){resetTasks();const panel=document.getElementById('taskHead')?.parentElement;document.getElementById('taskCount').textContent=S.tasks.filter(x=>x.done).length+'/3';document.getElementById('tasks').innerHTML=S.tasks.map(t=>`<div class="row"><span class="big">${t.done?'✅':'🌷'}</span><main><b>${t.text}</b><p>${t.p}/${t.max} · 奖励 ${t.reward}🪙 + ${t.energy||0}⚡</p><div class="bar"><i style="width:${t.p/t.max*100}%"></i></div></main></div>`).join('');if(panel){panel.classList.toggle('task-collapsed',!!S.tasksCollapsed);document.getElementById('taskArrow').textContent=S.tasksCollapsed?'›':'⌄'}}
function recoverExplore(){let now=Date.now(),last=Number(S.lastExploreAt)||now,g=Math.floor(Math.max(0,now-last)/600000);if(g>0){S.explore=Math.min(S.exploreMax||5,(S.explore||0)+g);S.lastExploreAt=last+g*600000;save();return true}return false}
function dailyEvent(){recoverEnergy();recoverExplore();if(S.eventDay!==today()){S.eventDay=today();S.event=rand(EVENTS)[0];S.explore=Math.max(S.explore||0,Math.min(S.exploreMax||5,5));save() }let e=EVENTS.find(x=>x[0]===S.event)||EVENTS[0];document.getElementById('eventText').textContent=e[1]+' '+e[2]+'：'+e[3];document.getElementById('seasonTitle').textContent='🌸 春日花园 · 今日有'+e[2]}
function npcPhase(){let h=new Date().getHours();return h<11?'morning':h<17?'day':h<20?'dusk':'night'}
function phaseIndex(p){return {morning:0,day:1,dusk:2,night:3}[p]??0}
function makeNpcSchedule(){let d=today();if(S.npcSchedule?.day!==d){S.npcSchedule={day:d,events:[],visits:0};}let target=7,events=S.npcSchedule.events||[];let phases=['morning','day','dusk','night'];let usedCount={};events.forEach(e=>usedCount[e.name]=(usedCount[e.name]||0)+1);while(events.length<target){let phase=phases[Math.floor(events.length/2)];let pool=NPCS.filter(n=>n[4].includes(phase)).sort(()=>Math.random()-.5);let n=pool.find(x=>(usedCount[x[0]]||0)<2)||pool[0];if(!n)break;let pos=[0,4,1,6,8,3,7][events.length];let progress=(S.npcStory[n[0]]?.progress||0);events.push({name:n[0],pos,phase,state:'new',story:Math.min(2,progress),needKey:n[5][0],needQty:n[5][1]});usedCount[n[0]]=(usedCount[n[0]]||0)+1;}S.npcSchedule.events=events;save()}
function npcEvent(name){makeNpcSchedule();return S.npcSchedule.events.find(e=>e.name===name&&e.state!=='done')||S.npcSchedule.events.find(e=>e.name===name)}
function npcNeedText(e){let [type,id]=e.needKey.split(':');if(type==='flower'){let f=flowerByLv(+id);return (f?f.name:id)+' ×'+e.needQty}return (MATERIALS[id]?.name||id)+' ×'+e.needQty}
function npcHave(e){if(e.needKey.startsWith('flower:')){let lv=+e.needKey.split(':')[1];return S.board.filter(x=>x===lv).length}return S.bag[e.needKey]||0}
function npc(name){let e=npcEvent(name),n=NPCS.find(x=>x[0]===name);if(!e||!n)return;let st=S.npcStory[name]||{progress:0},story=(NPC_STORIES[name]||[])[Math.min(2,st.progress||0)]||'';if(e.state==='new'){e.state='accepted';save();showModal(n[1]+' '+n[0],`<div class="story"><b>${story}</b><p>${n[3]}</p><p>${name}需要：<strong>${npcNeedText(e)}</strong></p><div class="choice"><button class="btn primary" onclick="closeModal()">我来帮你</button><button class="btn" onclick="closeModal()">先去准备</button></div></div>`)}else if(e.state==='accepted'){let ready=npcHave(e)>=e.needQty;showModal(n[1]+' '+n[0],`<div class="story"><b>${ready?'“你找到了！可以交给我了吗？”':'“我还在这里等你呢。”'}</b><p>任务：${['芽芽的花篮','团团的蜂蜜点心','栗栗的藏宝图','星星的月光秘密','花婆婆的旧纸条'][Math.max(0,NPCS.findIndex(x=>x[0]===name))]}</p><p>进度：${Math.min(npcHave(e),e.needQty)}/${e.needQty}</p><div class="choice"><button class="btn ${ready?'primary':''}" onclick="npcReward('${name}')">${ready?'交付并领取奖励':'看看任务'}</button><button class="btn" onclick="closeModal()">稍后</button></div></div>`)}else toast(name+'已经完成今天的事情啦')}
function npcReward(name){let e=npcEvent(name),n=NPCS.find(x=>x[0]===name);if(!e||!n||e.state!=='accepted')return;if(npcHave(e)<e.needQty)return toast('还差：'+npcNeedText(e));if(e.needKey.startsWith('flower:')){let lv=+e.needKey.split(':')[1],left=e.needQty;S.board=S.board.map(x=>{if(x===lv&&left>0){left--;return null}return x})}else addBag(e.needKey,-e.needQty);e.state='done';S.coins+=n[6];let before=S.energy;S.energy=Math.min(S.maxEnergy,S.energy+n[7]);S.lastEnergyAt=Date.now();S.reputation=(S.reputation||0)+1;S.npcTrust[name]=(S.npcTrust[name]||0)+1;let st=S.npcStory[name]||{progress:0};st.progress=Math.min(3,(st.progress||0)+1);st.last=Date.now();S.npcStory[name]=st;if(name==='芽芽')S.eco.flower=(S.eco.flower||0)+2;if(name==='栗栗')addBag('mat:dust',1);if(name==='星星')addBag('mat:moon',1);if(name==='花婆婆')addBag('tool:energyBottle',1);if(Math.random()<.35)addBag('flower:1',1);closeModal();toast(n[1]+' '+name+'：谢谢你！ +'+n[6]+'🪙 +'+(S.energy-before)+'⚡');save();renderAll()}
function renderNpcWorld(){makeNpcSchedule();let ev=S.npcSchedule.events||[],phase=phaseIndex(npcPhase()),cells=[];for(let i=0;i<9;i++){let e=ev.find(x=>x.pos===i&&phaseIndex(x.phase)<=phase&&x.state!=='done');if(e){let n=NPCS.find(x=>x[0]===e.name);cells.push(`<div class="npc-cell has" onclick="npc('${e.name}')"><span class="npc-emoji">${n[1]}</span><small>${n[0]} · ${e.state==='accepted'?'任务中':'来访'}</small><i class="npc-dot"></i></div>`)}else cells.push(`<div class="npc-cell"><span style="font-size:18px;opacity:.35">${['🌷','🌿','🌳','🌼','🍃','🪵','🌸','🪴','✨'][i]}</span><small>空闲格</small></div>`)}document.getElementById('npcWorldGrid').innerHTML=cells.join('');let active=ev.filter(e=>phaseIndex(e.phase)<=phase&&e.state!=='done').length;let future=ev.filter(e=>phaseIndex(e.phase)>phase).length;document.getElementById('npcHint').textContent=active?`当前 ${active} 位来访${future?' · 稍后还有 '+future+' 位':''}`:(future?'稍后还有 '+future+' 位来访':'今天的来访都完成啦')}
function renderWorld(){renderNpcWorld();document.getElementById('chapters').innerHTML=CHAPTERS.map((c,i)=>{let open=i===0||S.flowerXp>=i*8||S.completedTasks>=i*2;return `<div class="chapter ${open?'':'lock'}"><div class="chico">${c[1]}</div><main><b>第${c[0]}章 · ${c[2]}</b><p>${c[3]}</p><span class="tag">${open?'已开放':'🔒 '+c[4]}</span></main><span>${open?'🌱':'🔒'}</span></div>`}).join('')}
function ecoScore(){return Object.values(S.eco).reduce((a,b)=>a+(Number(b)||0),0)}
function ecoStyle(){let e=S.eco;if(e.water>=e.forest+8&&e.water>=e.night+5)return '🌊 湖畔花园';if(e.forest>=e.water+8&&e.forest>=e.night+5)return '🌳 神秘森林';if(e.night>=e.water+8)return '🌙 月光花园';if(e.honey>=e.water+6&&e.honey>=e.forest+4)return '🍯 蜜源花园';if(e.beauty>=20&&ecoScore()>=35)return '🌈 梦幻花园';return '🌸 混合生态花园'}
function homeItem(id){if(id.startsWith('special:')){let s=SPECIAL.find(x=>x.id===id.slice(8));return s?{id,emoji:s.emoji,name:s.name,eco:itemRule(s.id)?.eco||{}}:null}let d=DECOR.find(x=>x[0]===id);return d?{id,emoji:d[2],name:d[1],eco:{[d[3][0]]:d[3][1]}}:null}
function ecoLiving(){let e=S.eco||{},out=[];if(e.water>=8)out.push('🐸 青蛙喜欢这里');if(e.forest>=8)out.push('🐿️ 松鼠愿意留下');if(e.honey>=8)out.push('🐝 蜜蜂正在采蜜');if(e.night>=8)out.push('✨ 夜晚会有萤火虫');if(e.flower>=8)out.push('🦋 花蝶更容易出现');return out.length?out.join(' · '):'🌱 生态还在成长，摆放更多植物或设施会吸引新的小生命。'}
function ecoYieldTick(){let now=Date.now(),last=Number(S.lastEcoTick)||now,steps=Math.floor(Math.max(0,now-last)/300000);if(!steps)return false;steps=Math.min(steps,12);let e=S.eco||{}, y=S.homeYield||{dew:0,honey:0,moon:0,dust:0};let gain=0;if(e.water>=8)y.dew=Math.min(5,(y.dew||0)+Math.floor(steps*(e.water>=15?0.5:0.25)));if(e.honey>=8)y.honey=Math.min(5,(y.honey||0)+Math.floor(steps*(e.honey>=15?0.5:0.25)));if(e.night>=8)y.moon=Math.min(5,(y.moon||0)+Math.floor(steps*(e.night>=15?0.5:0.25)));if(e.forest>=10&&e.flower>=8)y.dust=Math.min(3,(y.dust||0)+Math.floor(steps*.15));S.homeYield=y;S.lastEcoTick=last+steps*300000;return true}
function harvestEco(k){ecoYieldTick();let y=S.homeYield||{};let n=y[k]||0;if(n<1)return toast('🌱 还没有成熟的生态产物');addBag('mat:'+k,n);y[k]=0;S.homeYield=y;S.ecoHarvested=(S.ecoHarvested||0)+n;S.research.points=(S.research.points||0)+Math.min(5,n);save();renderAll();toast('🌿 收获 '+MATERIALS[k].emoji+' '+MATERIALS[k].name+' ×'+n)}
function homeCreatureList(){let e=S.eco||{},a=[];if(e.flower>=8)a.push('🦋 蝴蝶');if(e.honey>=8)a.push('🐝 蜜蜂');if(e.water>=8)a.push('🐸 青蛙');if(e.forest>=8)a.push('🐿️ 松鼠');if(e.forest>=12&&e.flower>=10)a.push('🐦 小鸟');if(e.night>=8)a.push('✨ 萤火虫');if(e.water>=15&&e.night>=10)a.push('🦋 月光蝶');return a}
function renderHome(){ecoYieldTick();let hg=document.getElementById('homeGrid');hg.innerHTML=S.home.map((id,i)=>{let x=id?homeItem(id):null;return `<div class="home-cell ${id?'has':''}" data-home="${i}">${x?x.emoji:'＋'}${x?`<small style="position:absolute;bottom:2px;font-size:7px;opacity:.55">${x.name}</small>`:''}</div>`}).join('');document.querySelectorAll('[data-home]').forEach(c=>c.onclick=()=>placeHome(+c.dataset.home));let keys=['beauty','flower','water','forest','honey','night'];document.getElementById('eco').innerHTML=keys.map(k=>`<div class="card"><b>${ECO_INFO[k][0]}</b>${S.eco[k]||0}<div class="mini">${ECO_INFO[k][1]}</div></div>`).join('');document.getElementById('ecoTotal').textContent=ecoScore();document.getElementById('ecoStyle').textContent=ecoStyle();let creatures=homeCreatureList();document.getElementById('ecoLiving').innerHTML=`<b>🌿 ${ecoStyle()}</b><p>${ecoLiving()}</p><p>🐾 当前可能常驻：${creatures.length?creatures.join(' · '):'还没有形成稳定生态'}</p>`;let y=S.homeYield||{};let ys=[['dew','💧','水露','水域≥8'],['honey','🍯','蜂蜜','蜜源≥8'],['moon','🌙','月光','夜光≥8'],['dust','✨','星尘','森林≥10且花朵≥8']];document.getElementById('ecoYield').innerHTML=ys.map(x=>`<div class="row"><span class="big">${x[1]}</span><main><b>${x[2]} ×${y[x[0]]||0}</b><p>${x[3]} · 家园会随时间自然积累</p></main><button class="btn ${(y[x[0]]||0)>0?'primary':''}" onclick="harvestEco('${x[0]}')">收获</button></div>`).join('');document.getElementById('yieldHint').textContent=creatures.length?`已有 ${creatures.length} 种生物愿意来这里`:'摆放更多生态物件';let known=homeCreatureList();document.getElementById('homeCreatures').innerHTML=known.length?known.map(x=>`<div class="creature"><span class="animal">${x.slice(0,2)}</span><b>${x.slice(2)}</b><div class="mini">会随生态/时间来访</div></div>`).join(''):'<div class="card">还没有稳定居民。提高对应生态值，就会有人来。</div>';let goals=[['🌸','发现神秘花',(S.recipes||[]).length,SPECIAL.length],['🔬','研究变异',(S.research?.mutations||[]).length,10],['🐾','发现生物',(S.creatures||[]).length,CREATURES.length],['🏡','生态值',ecoScore(),50],['🎁','开启宝箱',(S.treasuresOpened||0),20]];document.getElementById('longGoals').innerHTML=goals.map(g=>`<div class="row"><span class="big">${g[0]}</span><main><b>${g[1]}</b><p>${Math.min(g[2],g[3])}/${g[3]}</p><div class="bar"><i style="width:${Math.min(100,g[2]/g[3]*100)}%"></i></div></main></div>`).join('')};
function placeHome(i){if(S.home[i]){let id=S.home[i],x=homeItem(id);if(x){if(id.startsWith('special:'))addBag(id,1);else{let d=DECOR.find(z=>z[0]===id);S.decorBag[id]=(S.decorBag[id]||0)+1;S.eco[d[3][0]]-=d[3][1]}if(id.startsWith('special:'))Object.entries(x.eco).forEach(([k,v])=>S.eco[k]-=v)}S.home[i]=null;toast('🏡 已收回');save();renderAll();return}openDecor()}
function openDecor(){let html='<div class="card"><b>🏡 家园摆放规则</b><p>装饰与神秘花都可以摆放。神秘花会真正改变生态，生态倾向又会影响生物、资源与事件。不同摆法会产生不同结果。</p></div><div class="list">';DECOR.forEach(d=>{let n=(S.decorBag&&S.decorBag[d[0]])||0;html+=`<div class="row"><span class="big">${d[2]}</span><main><b>${d[1]}</b><p>库存 ${n} · ${ECO_INFO[d[3][0]]?.[0]||d[3][0]} +${d[3][1]}</p></main><button class="btn ${n?'primary':''}" ${n?'data-place-decor="'+d[0]+'"':''}>${n?'选择':'未拥有'}</button></div>`});SPECIAL.filter(s=>S.bag['special:'+s.id]).forEach(s=>{let r=itemRule(s.id),eco=Object.entries(r.eco).map(([k,v])=>(ECO_INFO[k]?.[0]||k)+' +'+v).join(' · ');html+=`<div class="row"><span class="big">${s.emoji}</span><main><b>${s.name}</b><p>库存 ${S.bag['special:'+s.id]} · ${eco}</p></main><button class="btn primary" data-place-special="${s.id}">选择</button></div>`});html+='</div>';showModal('🏡 家园装饰与神秘花',html);document.querySelectorAll('[data-place-decor]').forEach(b=>b.onclick=()=>selectDecor(b.dataset.placeDecor));document.querySelectorAll('[data-place-special]').forEach(b=>b.onclick=()=>selectSpecialHome(b.dataset.placeSpecial))}
function selectDecor(id){let empty=S.home.findIndex(x=>!x);if(empty<0)return toast('🏡 家园已经放满了');if(!(S.decorBag[id]>0))return toast('还没有这个装饰');let d=DECOR.find(x=>x[0]===id);S.decorBag[id]--;S.home[empty]=id;S.eco[d[3][0]]=(S.eco[d[3][0]]||0)+d[3][1];closeModal();toast('🏡 已放置 '+d[1]);save();renderAll()}
function selectSpecialHome(id){let empty=S.home.findIndex(x=>!x);if(empty<0)return toast('🏡 家园已经放满了');let key='special:'+id;if(!(S.bag[key]>0))return toast('这朵神秘花不在背包里');let r=itemRule(id);addBag(key,-1);S.home[empty]=key;Object.entries(r.eco).forEach(([k,v])=>S.eco[k]=(S.eco[k]||0)+v);closeModal();toast('🏡 已放置 '+SPECIAL.find(x=>x.id===id).name);save();renderAll()}
function openResearch(){let html=`<div class="research"><b>🔬 研究规则</b><p>神秘花不是收集完就结束。每次研究都会积累研究值；不同家园生态可能发现不同变异方向。</p><p>当前研究值：<strong>${S.research.points||0}</strong> · 已研究：${S.research.studied.length}/${SPECIAL.length} · 已发现变异：${S.research.mutations.length}</p></div><div class="list">`;SPECIAL.forEach(s=>{let r=itemRule(s.id),owned=S.bag['special:'+s.id]||0,studied=S.research.studied.includes(s.id),variants=['night','water','honey','forest','hybrid'].filter(v=>S.research.mutations.includes(s.id+'-'+v));html+=`<div class="row"><span class="big">${s.emoji}</span><main><b>${s.name}</b><p>${studied?'已研究 · '+(variants.length?'发现变异：'+variants.join('、'):'继续改变生态可发现更多') :owned?'拥有 '+owned+' · 消耗1朵研究':'尚未拥有'}</p></main><button class="btn ${owned?'primary':''}" ${owned?`onclick="studyFlower('${s.id}')"`:''}>${owned?'研究':'未拥有'}</button></div>`});html+='</div>';showModal('🔬 神秘花研究所',html)}
function studyFlower(id){let key='special:'+id;if(!(S.bag[key]>0)&&!S.research.studied.includes(id))return toast('先获得这朵神秘花');let r=itemRule(id),first=!S.research.studied.includes(id);let cost=first?0:3;if((S.research.points||0)<cost)return toast('研究值不足，再去家园观察或完成任务吧');if(first)S.research.studied.push(id);else S.research.points-=cost;let gain=first?8:2;S.research.points=(S.research.points||0)+gain;let candidates=[];if(S.eco.night>=12&&r.eco.night)candidates.push('night');if(S.eco.water>=12&&r.eco.water)candidates.push('water');if(S.eco.honey>=12&&r.eco.honey)candidates.push('honey');if(S.eco.forest>=12&&r.eco.forest)candidates.push('forest');if(ecoScore()>=30)candidates.push('hybrid');let mutation=candidates.length?rand(candidates):null,discovered=mutation&&!S.research.mutations.includes(id+'-'+mutation);if(discovered)S.research.mutations.push(id+'-'+mutation);save();renderAll();openResearch();toast('🔬 '+(first?'建立研究档案':'继续研究')+'！ +'+gain+'研究值'+(discovered?' · 发现新变异方向！':''))}
function openExchange(){let html='<div class="card"><b>🔄 兑换</b><p>多余的花朵和特殊材料可以换成金币、道具或家园装饰。兑换不是单向消耗：你要决定什么值得留下。</p></div><div class="list">';EXCHANGES.forEach(x=>{let have=S.bag[x[3]]||0;let reward=x[5];let label=reward==='coins'?x[6]+'🪙':reward.startsWith('tool:')?TOOLS[reward.slice(5)].name+' ×'+x[6]:reward.startsWith('decor:')?DECOR.find(d=>d[0]===reward.slice(6))?.[1]+' ×'+x[6]:reward;html+=`<div class="row"><span class="big">${x[1].split(' ')[0]}</span><main><b>${x[1]}</b><p>${x[2]} · 拥有 ${have}</p></main><button class="btn ${have>=x[4]?'primary':''}" data-exchange="${x[0]}">兑换</button></div>`});html+='</div>';showModal('🔄 物品兑换',html);document.querySelectorAll('[data-exchange]').forEach(b=>b.onclick=()=>exchange(b.dataset.exchange))}
function exchange(id){let x=EXCHANGES.find(e=>e[0]===id);if(!x)return;let have=S.bag[x[3]]||0;if(have<x[4])return toast('材料还不够哦');addBag(x[3],-x[4]);if(x[5]==='coins'){S.coins+=x[6]}else if(x[5].startsWith('tool:')){addBag(x[5],x[6])}else if(x[5].startsWith('decor:')){let d=x[5].slice(6);S.decorBag[d]=(S.decorBag[d]||0)+x[6];if(!S.decorUnlocked.includes(d))S.decorUnlocked.push(d)}toast('🔄 兑换成功');save();renderAll();openExchange()}
function openTreasure(kind='chest'){let pool=kind==='rare'?['mat:dust','mat:rainbow','tool:energyBottle','tool:growthPowder','decor:rainbowBed']:['coins','mat:dew','mat:honey','mat:moon','tool:energyBottle'];let k=rand(pool),n=1;if(k==='coins'){S.coins+=80;toast('🎁 宝箱开启：+80🪙')}else if(k.startsWith('decor:')){let d=k.slice(6);S.decorBag[d]=(S.decorBag[d]||0)+1;if(!S.decorUnlocked.includes(d))S.decorUnlocked.push(d);toast('🎁 宝箱开启：'+(DECOR.find(x=>x[0]===d)?.[1]||'特殊装饰'))}else{addBag(k,n);let label=k.startsWith('tool:')?TOOLS[k.slice(5)]?.name:k.startsWith('mat:')?MATERIALS[k.slice(4)]?.name:k;toast('🎁 宝箱开启：'+(label||k)+' ×'+n)}S.treasuresOpened=(S.treasuresOpened||0)+1;save();renderAll();}
function openTreasureModal(){let chest=S.bag['treasure:chest']||0,rare=S.bag['treasure:rare']||0;showModal('🎁 宝箱',`<div class="card"><b>🌿 普通宝箱 ×${chest}</b><p>来源：星尘小径、生态事件。金币、基础材料、体力道具。</p><button class="btn ${chest?'primary':''}" onclick="${chest?'addBag(\'treasure:chest\',-1);openTreasure(\'chest\')':'toast(\'还没有普通宝箱\')'}">${chest?'开启':'没有宝箱'}</button></div><div class="card" style="margin-top:8px"><b>💎 稀有宝箱 ×${rare}</b><p>来源：高阶探索、神秘钥匙。稀有材料、道具、特殊装饰。</p><button class="btn ${rare?'primary':''}" onclick="${rare?'addBag(\'treasure:rare\',-1);openTreasure(\'rare\')':'toast(\'还没有稀有宝箱\')'}">${rare?'开启':'没有宝箱'}</button></div>`)}
function useTool(key){let n=S.bag['tool:'+key]||0;if(n<1)return toast('没有这个道具');if(key==='energyBottle'){addBag('tool:'+key,-1);S.energy+=15;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();toast('🧪 体力瓶 +15⚡')}else if(key==='growthPowder'){addBag('tool:'+key,-1);S.growthBoost=(S.growthBoost||0)+1;toast('✨ 生长粉已准备好，下次合成获得额外金币')}else if(key==='mysteryKey'){addBag('tool:'+key,-1);openTreasure('rare')}save();renderAll()}
function renderBook(){document.getElementById('bookTabs').innerHTML=['🌸花朵','🔮配方','🐾生物','🎁宝物','🏡家园','📜故事'].map((x,i)=>`<button class="chip" data-book="${i}">${x}</button>`).join('');document.querySelectorAll('[data-book]').forEach(x=>x.onclick=()=>bookPage(+x.dataset.book));bookPage(0)}
function bookPage(i){let html='';if(i===0)html='<div class="list">'+FLOWERS.map(f=>`<div class="row"><span class="big">${f.emoji}</span><main><b>${f.name} · ${'★'.repeat(f.rarity)}</b><p>等级 ${f.lv} · ${f.lv===1?'基础花芽':f.lv>=8?'珍稀花朵':'普通合成链'}</p></main><span>${S.discovered.includes(f.id)?'✓':'?'}</span></div>`).join('')+SPECIAL.map(s=>{let r=itemRule(s.id);return `<div class="row ${S.discovered.includes(s.id)?'':'unknown'}"><span class="big">${S.discovered.includes(s.id)?s.emoji:'❔'}</span><main><b>${S.discovered.includes(s.id)?s.name:'神秘花朵'}</b><p>${S.discovered.includes(s.id)?'来源：'+r.source+' · 用途：'+r.use:'继续探索后解锁线索'}</p></main><span>${S.discovered.includes(s.id)?'✓':'?'}</span></div>`}).join('')+'</div>';if(i===1)html='<div class="list">'+SPECIAL.map(s=>`<div class="row"><span class="big">🔮</span><main><b>${S.recipes.includes(s.id)?s.name:'???'}</b><p>${S.recipes.includes(s.id)?'已发现配方':'隐藏配方 · 继续探索'}</p></main></div>`).join('')+'</div>';if(i===2)html='<div class="cards">'+CREATURES.map(c=>`<div class="card"><b>${S.creatures.includes(c[0])?c[2]+' '+c[1]:'❔ 未发现'}</b><span class="mini">${S.creatures.includes(c[0])?'已遇见':'在合适的生态中出现'}</span></div>`).join('')+'</div>';if(i===3)html='<div class="cards"><div class="card"><b>🎁 神秘宝箱</b>探索星尘小径获得</div><div class="card"><b>🌟 世界种子</b>极少见的隐藏物</div></div>';if(i===4)html='<div class="list">'+DECOR.map(d=>`<div class="row"><span class="big">${d[2]}</span><main><b>${d[1]}</b><p>${S.decorUnlocked.includes(d[0])?'已解锁':'等待章节或事件'}</p></main></div>`).join('')+'</div>';if(i===5)html='<div class="card"><b>📜 花婆婆的故事</b><p>“你合成的每一样东西，都可能成为这个世界的一部分。”</p></div>';document.getElementById('bookContent').innerHTML=html}
function explore(path){recoverExplore();if(S.explore<=0)return toast('🔍 探索次数暂时用完啦，约 10 分钟恢复 1 次，也可通过活跃奖励获得');S.explore--;S.lastExploreAt=Date.now();taskProgress('explore');let r=Math.random(),msg='';if(path==='flower'){addBag('mat:honey',1);discoverCreature(S.eco.honey>=8?'bee':'butterfly');msg='🐝 找到了蜂蜜';}else if(path==='water'){addBag('mat:dew',1);discoverCreature(S.eco.water>=8?'frog':'butterfly');msg='💧 找到了水露';}else if(path==='moon'){addBag('mat:moon',1);discoverCreature(S.eco.night>=8?'firefly':'moonButterfly');msg='🌙 捡到了月光';}else{addBag('mat:dust',1);if(r<.25+(S.eco.beauty>=20?.08:0)){addBag('mat:rainbow',1);msg='🌈 流星照亮了彩虹碎片'}else{addBag('treasure:chest',1);msg='🎁 找到神秘宝箱'}}save();toast(msg);renderAll()}
function discoverCreature(id){if(!S.creatures.includes(id)){S.creatures.push(id);toast('🐾 新生物发现！')} }
function renderExplore(){recoverExplore();document.getElementById('exploreEnergy').textContent=S.explore;document.getElementById('events').innerHTML=EVENTS.slice(0,5).map(e=>`<div class="row"><span class="big">${e[1]}</span><main><b>${e[2]}</b><p>${e[3]}</p></main>${S.event===e[0]?'<span>今天</span>':''}</div>`).join('');let active=(S.npcSchedule?.events||[]).filter(e=>e.state!=='done');document.getElementById('npcs').innerHTML=active.length?active.map(e=>{let n=NPCS.find(x=>x[0]===e.name);return `<div class="row"><span class="big">${n[1]}</span><main><b>${n[0]} · ${e.state==='accepted'?'任务进行中':'今日来访'}</b><p>${e.state==='accepted'?'需要 '+npcNeedText(e):n[2]}</p></main><button class="btn" onclick="npc('${n[0]}')">查看</button></div>`}).join(''):'<div class="card">今天的 NPC 都已经完成拜访啦。明天会有新的来访。</div>'}
function showModal(title,body){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBody').innerHTML=body;document.getElementById('modal').classList.add('show')};function closeModal(){document.getElementById('modal').classList.remove('show')};document.getElementById('close').onclick=closeModal;document.getElementById('saveBtn').onclick=manualSave;document.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal()}
document.getElementById('spawn').onclick=()=>{if(spawn())taskProgress('collect')};document.getElementById('sort').onclick=sortBoard;document.getElementById('researchBtn').onclick=openResearch;document.getElementById('special').onclick=openSpecial;document.getElementById('exchange').onclick=openExchange;document.getElementById('shop').onclick=openShop;document.getElementById('bagUpgrade').onclick=upgradeBag;document.querySelectorAll('[data-path]').forEach(b=>b.onclick=()=>explore(b.dataset.path));
let musicEnabled=S.music!==false,bgm=new Audio('assets/audio/bgm.m4a');bgm.loop=true;bgm.volume=.22;document.getElementById('music').onclick=()=>{musicEnabled=!musicEnabled;S.music=musicEnabled;localStorage.setItem('flowerTownMusic',musicEnabled?'on':'off');if(musicEnabled)bgm.play().catch(()=>{});else bgm.pause();document.getElementById('music').textContent=musicEnabled?'🎵':'🔇';save()};document.addEventListener('pointerdown',()=>{if(musicEnabled)bgm.play().catch(()=>{})},{once:true});
function playerLevel(){return Math.max(1,Math.min(20,1+Math.floor((S.flowerXp||0)/20)))}
function checkAchievements(){let a=[['first','初次绽放',S.flowerXp>=2],['hundred','百花齐放',Object.keys(S.bag).filter(k=>k.startsWith('flower:')).length>=5],['recipes','配方大师',(S.recipes||[]).length>=5],['night','夜行者',(S.bag['mat:moon']||0)>=3],['world','我的世界',Object.keys(S.bag).length>=10],['rainbow','彩虹之心',(S.bag['mat:rainbow']||0)>=1]];a.forEach(x=>{if(x[2]&&!S.achievements.includes(x[0])){S.achievements.push(x[0]);S.coins+=50;toast('🏆 '+x[1]+'！ +50🪙')}})}
function manualSave(){save();toast('💾 小镇已保存')}
document.getElementById('taskHead').onclick=()=>{S.tasksCollapsed=!S.tasksCollapsed;save();renderTasks()};document.getElementById('taskToggle').onclick=e=>e.stopPropagation();
function resetGame(){if(confirm('确定要重新开始《花花小镇》吗？当前本地存档会被覆盖。')){localStorage.removeItem(KEY);location.reload()}}
function claimDailyEnergy(){let d=today();if(S.loginDay===d&&S.loginClaimed)return toast('🌷 今日的登录体力已经领过啦');S.loginDay=d;S.loginClaimed=true;S.energy+=30;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();toast('🎁 每日登录礼物：+30⚡');save();renderAll()}
function openShop(){let d=today();if(S.shopDay!==d){S.shopDay=d;S.shopEnergyBuys=0}let bought=S.shopEnergyBuys||0;let html=`<div class="card"><b>🌷 每日免费体力</b><p>每天第一次打开商店可领取 15⚡。</p><button class="btn primary" id="dailyEnergy">领取 15⚡</button></div><div class="list"><div class="row"><span class="big">⚡</span><main><b>小瓶体力</b><p>恢复 10⚡ · 今日已购买 ${bought}/3 次</p></main><button class="btn" data-buyenergy="15">100🪙</button></div><div class="row"><span class="big">💗</span><main><b>中瓶体力</b><p>恢复 30⚡ · 今日已购买 ${bought}/3 次</p></main><button class="btn" data-buyenergy="30">250🪙</button></div><div class="row"><span class="big">🌈</span><main><b>大瓶体力</b><p>恢复 60⚡ · 今日已购买 ${bought}/3 次</p></main><button class="btn" data-buyenergy="60">500🪙</button></div></div><div class="card"><b>🧰 道具与资源</b><p>体力瓶、成长粉、神秘钥匙都可以通过商店、任务、兑换或宝箱获得，不依赖付费。</p><button class="btn" id="toolPack">购买道具礼包</button></div><div class="card"><b>🌱 其他商品</b><p>花芽礼包：5 个花芽 · 80🪙</p><button class="btn" id="seedPack">购买</button></div>`;showModal('🛍️ 花花小镇商店',html);document.getElementById('dailyEnergy').onclick=()=>{let key='shopFreeEnergy_'+d;if(localStorage.getItem(key))return toast('今天已经领过免费体力啦');localStorage.setItem(key,'1');S.energy+=15;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();toast('🎁 免费体力 +15⚡');save();openShop()};document.querySelectorAll('[data-buyenergy]').forEach(b=>b.onclick=()=>buyEnergy(+b.dataset.buyenergy));document.getElementById('toolPack').onclick=()=>{if(S.coins<180)return toast('🪙 金币不够');S.coins-=180;addBag('tool:energyBottle',1);addBag('tool:growthPowder',1);toast('🧰 道具礼包：体力瓶×1 + 生长粉×1');save();renderAll();openShop()};document.getElementById('seedPack').onclick=()=>{if(S.coins<80)return toast('🪙 金币不够');if(bagCount()>=S.bagCap)return toast('🎒 背包空间不够');S.coins-=80;addBag('flower:1',5);toast('🌱 花芽礼包已购买');save();renderAll();openShop()};}
function buyEnergy(n){let d=today();if(S.shopDay!==d){S.shopDay=d;S.shopEnergyBuys=0}if((S.shopEnergyBuys||0)>=3)return toast('🛍️ 今日体力购买次数已用完');let cost=n===15?100:n===30?220:420;if(S.coins<cost)return toast('🪙 金币不够');S.coins-=cost;S.energy+=n;if(S.energy>=S.maxEnergy)S.lastEnergyAt=Date.now();S.shopEnergyBuys=(S.shopEnergyBuys||0)+1;toast('⚡ 购买体力 +'+(S.energy-before));save();renderAll();openShop()}
function renderAll(){ecoYieldTick();dailyEvent();makeNpcSchedule();document.getElementById('coins').textContent=S.coins;document.getElementById('energy').textContent=S.energy;document.getElementById('level').textContent=playerLevel();checkAchievements();renderBoard();renderTasks();renderInventory();renderWorld();renderHome();renderBook();renderExplore()}
renderAll();setInterval(()=>{let changed=recoverEnergy();energyTimer();if(changed){save();renderAll()}},1000);
</script></body></html>

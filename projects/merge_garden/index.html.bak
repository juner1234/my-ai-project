<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>花花小镇 · 最终版 · 会慢慢长大的小世界</title>
<style>
:root{--ink:#4b3b55;--pink:#ff91b7;--purple:#c5a0ff;--green:#9bd49e;--cream:#fffaf3;--line:#eadfec;--shadow:0 10px 28px rgba(80,55,90,.12)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{margin:0;min-height:100vh;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:linear-gradient(180deg,#fff4f8,#f3efff 55%,#eef9ed);overflow-x:hidden}.app{width:min(100%,620px);margin:auto;padding:12px 12px 82px}.top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}.brand{display:flex;align-items:center;gap:8px}.logo{width:44px;height:44px;border-radius:15px;background:#fff;display:grid;place-items:center;font-size:26px;box-shadow:var(--shadow)}h1{font-size:19px;margin:0}.sub{font-size:10px;opacity:.55;margin-top:2px}.stats{display:flex;gap:4px;align-items:center}.pill{background:#fff;border-radius:12px;padding:7px 8px;box-shadow:0 5px 14px rgba(80,55,90,.08);font-size:11px;white-space:nowrap}.music{cursor:pointer}.view{display:none}.view.active{display:block}.hero{border-radius:22px;padding:14px 15px;background:linear-gradient(135deg,#ffe0eb,#eee5ff);box-shadow:var(--shadow);margin-bottom:9px}.hero b{font-size:15px}.hero p{font-size:11px;line-height:1.5;opacity:.62;margin:5px 0 0}.panel{background:#fff;border-radius:19px;padding:11px;margin-bottom:9px;box-shadow:var(--shadow)}.panel-title{display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:800;margin-bottom:8px}.task-toggle{border:0;background:transparent;color:inherit;font:inherit;padding:0;cursor:pointer}.task-head{cursor:pointer;user-select:none}.task-collapsed #tasks{display:none}.task-head span{font-size:11px}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.cell{aspect-ratio:1;border-radius:15px;background:linear-gradient(145deg,#f2edf5,#fff);display:grid;place-items:center;position:relative;overflow:hidden;border:1px solid rgba(190,170,190,.12)}.cell.target{outline:3px solid #ff9cbe}.item{width:88%;height:88%;object-fit:contain;filter:drop-shadow(0 4px 4px rgba(80,55,90,.14));touch-action:none;user-select:none}.lv{position:absolute;right:3px;bottom:2px;background:rgba(255,255,255,.9);font-size:8px;border-radius:6px;padding:1px 3px}.bottom{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.btn{border:0;background:#fff;border-radius:15px;padding:10px 5px;color:inherit;font-weight:800;font-size:11px;box-shadow:0 6px 16px rgba(80,55,90,.08);cursor:pointer}.primary{background:linear-gradient(135deg,#ff91b7,#c5a0ff);color:#fff}.btn:active{transform:scale(.98)}.bar{height:7px;border-radius:8px;background:#f0eaf2;overflow:hidden}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ff91b7,#c5a0ff);border-radius:8px}.mini{font-size:10px;opacity:.6}.chips{display:flex;gap:6px;overflow:auto}.chip{flex:0 0 auto;background:#faf5fb;border-radius:12px;padding:7px 9px;font-size:10px}.inv{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.slot{min-height:66px;background:#faf7fb;border-radius:12px;text-align:center;padding:6px;font-size:9px;position:relative}.slot .ico{font-size:23px;display:block}.slot small{opacity:.55}.badge{position:absolute;right:4px;top:3px;font-size:9px}.tabs{position:fixed;z-index:10;bottom:8px;left:50%;transform:translateX(-50%);width:min(calc(100% - 20px),596px);display:grid;grid-template-columns:repeat(5,1fr);gap:5px;padding:5px;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-radius:18px;box-shadow:0 10px 30px rgba(70,50,80,.18)}.tab{border:0;background:transparent;border-radius:13px;padding:8px 2px;font-size:13px;color:var(--ink);cursor:pointer}.tab.active{background:linear-gradient(135deg,#ff94b9,#c5a0ff);color:#fff;font-weight:800}.cards{display:grid;grid-template-columns:1fr 1fr;gap:7px}.card{background:#fff8f4;border-radius:14px;padding:9px;font-size:10px}.card b{display:block;font-size:12px;margin-bottom:3px}.list{display:grid;gap:7px}.row{display:flex;align-items:center;gap:8px;background:#faf7fb;border-radius:14px;padding:9px}.row .big{font-size:27px}.row main{flex:1}.row b{font-size:11px}.row p{font-size:9px;opacity:.55;margin:2px 0}.tag{font-size:8px;background:#fff;border-radius:8px;padding:3px 5px}.map{min-height:540px;border-radius:23px;padding:13px;background:linear-gradient(180deg,#e6f5dc,#fff0f6 72%);position:relative;overflow:hidden;box-shadow:var(--shadow)}.path{position:absolute;left:28%;top:45px;bottom:45px;border-left:5px dotted rgba(170,145,175,.35);transform:rotate(3deg)}.chapter{position:relative;z-index:1;display:flex;align-items:center;gap:9px;background:#fff;border-radius:18px;padding:10px;margin:10px 2px;box-shadow:0 7px 18px rgba(80,55,90,.08)}.chapter.lock{opacity:.5}.npc-world{margin-top:10px}.npc-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.npc-cell{aspect-ratio:1;border-radius:15px;background:linear-gradient(145deg,#fff7fb,#f3f0ff);border:1px dashed rgba(150,125,165,.18);display:grid;place-items:center;position:relative;cursor:pointer}.npc-cell.has{border:2px solid #ffb4ce;background:linear-gradient(145deg,#fff0f6,#eee8ff);box-shadow:0 6px 14px rgba(120,90,140,.1)}.npc-cell .npc-emoji{font-size:29px;filter:drop-shadow(0 3px 3px rgba(80,55,90,.14))}.npc-cell small{position:absolute;bottom:3px;left:3px;right:3px;text-align:center;font-size:7px;opacity:.6}.npc-dot{position:absolute;right:3px;top:3px;width:8px;height:8px;border-radius:50%;background:#ff91b7}.story{background:#fff8f1;border-radius:15px;padding:11px;font-size:11px;line-height:1.6}.choice{display:grid;gap:6px;margin-top:8px}.chico{width:48px;height:48px;border-radius:16px;background:#fff0f6;display:grid;place-items:center;font-size:25px}.chapter main{flex:1}.chapter b{font-size:12px}.chapter p{font-size:9px;opacity:.55;margin:3px 0}.home{min-height:430px;border-radius:23px;padding:12px;background:radial-gradient(circle at 30% 20%,#fff 0 8%,transparent 9%),linear-gradient(180deg,#dff2d8,#fff1da 62%,#d9edf5);position:relative;overflow:hidden;box-shadow:var(--shadow)}.home-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;position:absolute;inset:72px 12px 12px}.home-cell{border-radius:14px;background:rgba(255,255,255,.23);display:grid;place-items:center;font-size:29px;cursor:pointer;border:1px dashed rgba(120,145,120,.2)}.home-cell.has{background:rgba(255,255,255,.48)}.eco{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.eco .card{text-align:center}.modal{position:fixed;inset:0;z-index:30;background:rgba(55,38,65,.3);display:none;align-items:flex-end;justify-content:center;padding:10px}.modal.show{display:flex}.sheet{width:min(100%,620px);max-height:86vh;overflow:auto;background:#fff;border-radius:24px 24px 16px 16px;padding:16px;box-shadow:0 -10px 40px rgba(40,25,50,.2)}.sheet h2{margin:0 0 6px;font-size:17px}.close{float:right;border:0;background:#f6eef7;border-radius:10px;padding:5px 9px;cursor:pointer}.toast{position:fixed;z-index:50;left:50%;bottom:78px;transform:translate(-50%,20px);opacity:0;background:#4b3b55;color:#fff;padding:9px 13px;border-radius:14px;font-size:11px;transition:.25s;white-space:nowrap}.toast.show{opacity:1;transform:translate(-50%,0)}.unknown{filter:grayscale(1);opacity:.35}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.detail-card{background:#faf7fb;border-radius:13px;padding:9px;font-size:10px}.detail-card b{display:block;font-size:11px;margin-bottom:3px}.research{background:linear-gradient(135deg,#fff3f8,#f1ecff);border-radius:16px;padding:10px;font-size:10px}.creature{background:rgba(255,255,255,.72);border-radius:15px;padding:10px;text-align:center;font-size:10px}.creature .animal{font-size:28px;display:block;margin-bottom:4px}.goalbar{display:flex;gap:8px;align-items:center}.goalbar main{flex:1}.research strong{font-size:15px}.star{color:#e3aa35}@media(max-width:390px){.app{padding-left:9px;padding-right:9px}.stats .pill{padding:6px}.grid{gap:5px}.cell{border-radius:12px}.inv{grid-template-columns:repeat(4,1fr)}}
</style></head>
<body><div class="app">
<header class="top"><div class="brand"><div class="logo">🌷</div><div><h1>花花小镇 · 最终版</h1><div class="sub">轻度合成 · 收集 · 探索 · 自由创造</div></div></div><div class="stats"><div class="pill">🪙 <span id="coins">0</span></div><div class="pill">⚡ <span id="energy">0</span><span class="mini" id="energyTimer" style="margin-left:3px">02:00</span></div><div class="pill">🌸 Lv.<span id="level">1</span></div><button class="pill music" id="music">🎵</button><button class="pill" id="saveBtn">💾</button></div></header>
<section id="garden" class="view active"><div class="hero"><b id="seasonTitle">🌸 春日花园</b><p id="eventText">今天的世界很安静，也许会有特别的事情发生。</p></div><div class="panel"><div class="panel-title task-head" id="taskHead"><button class="task-toggle" id="taskToggle">🎯 今日任务 <span id="taskCount">0/3</span></button><span id="taskArrow">⌄</span></div><div id="tasks" class="list"></div><div class="mini" style="margin-top:7px">🌟 每日小镇会持续发生事情：合成、探索、NPC故事、家园与收集都能获得奖励。</div></div><div class="panel"><div class="panel-title"><span>🌱 合成花园</span><span class="mini" id="boardHint">相同花朵可以合成</span></div><div id="grid" class="grid"></div></div><div class="bottom"><button class="btn primary" id="spawn">🌱 获得花芽<br><small>消耗 1⚡</small></button><button class="btn" id="special">✨ 特殊合成</button><button class="btn" id="researchBtn">🔬 研究</button><button class="btn" id="exchange">🔄 兑换</button><button class="btn" id="sort">🧹 整理</button><button class="btn" id="shop">🛍️ 商店</button></div><div class="panel"><div class="panel-title"><span>🎒 背包</span><span id="bagCap">0/30</span></div><div id="inventory" class="inv"></div><button class="btn" style="width:100%;margin-top:7px" id="bagUpgrade">升级背包</button><button class="btn primary" style="width:100%;margin-top:7px" id="loginGift" onclick="claimDailyEnergy()">🎁 每日领取 +30⚡</button></div></section>
<section id="world" class="view"><div class="hero"><b>🗺️ 世界地图</b><p>章节不是单纯增加素材，而是逐步打开这个世界的玩法。</p><button class="btn" onclick="manualSave()">💾 保存进度</button> <button class="btn" onclick="resetGame()">↻ 重置</button></div><div class="panel npc-world"><div class="panel-title"><span>🐾 今天的小镇来访</span><span class="mini" id="npcHint">看看谁来了</span></div><p class="mini">NPC 会在不同时间来到不同格子。接到任务后会一直留在那里，完成并交付后才会离开。</p><div id="npcWorldGrid" class="npc-grid"></div></div><div class="map"><div class="path"></div><div id="chapters"></div></div></section>
<section id="home" class="view"><div class="hero"><b>🏡 我的花园</b><p>把收集到的东西真正放进世界。不同摆放会影响生态与来访者。</p></div><div class="home"><div class="home-grid" id="homeGrid"></div></div><div class="panel"><div class="panel-title"><span>🌿 当前生态</span><span id="ecoTotal">0</span></div><div class="eco" id="eco"></div><div id="ecoLiving" class="research" style="margin-top:8px"></div></div><div class="panel"><div class="panel-title"><span>🌱 生态收获</span><span class="mini" id="yieldHint">等待家园生长</span></div><div id="ecoYield" class="list"></div></div><div class="panel"><div class="panel-title"><span>🐾 今日家园居民</span><span class="mini">会随生态变化</span></div><div id="homeCreatures" class="cards"></div></div><div class="panel"><div class="panel-title"><span>🎯 长期目标</span><span class="mini">不是只有收集</span></div><div id="longGoals" class="list"></div></div></section>
<section id="book" class="view"><div class="hero"><b>📖 小镇图鉴</b><p>发现过的花、配方、生物、宝物、家园与故事都会留在这里。</p></div><div class="chips" id="bookTabs"></div><div class="panel" id="bookContent"></div></section>
<section id="explore" class="view"><div class="hero"><b>🔍 探索</b><p>去森林小路看看。不同选择可能遇见材料、宝箱、生物，甚至隐藏配方。</p></div><div class="panel"><div class="panel-title"><span>🌳 神秘森林 · 第一条小路</span><span class="mini">探索次数 <span id="exploreEnergy">5</span></span></div><div class="cards"><button class="btn" data-path="flower">🌸 花香小径<br><small>花朵 / 蜜蜂</small></button><button class="btn" data-path="water">💧 水声小径<br><small>水露 / 青蛙</small></button><button class="btn" data-path="moon">🌙 暗影小径<br><small>月光 / 萤火虫</small></button><button class="btn" data-path="star">✨ 星尘小径<br><small>星尘 / 宝箱</small></button></div></div><div class="panel"><div class="panel-title"><span>🌦️ 今日世界事件</span><button class="btn" onclick="openTreasureModal()">🎁 宝箱</button></div><div id="events" class="list"></div></div><div class="panel"><div class="panel-title"><span>🐰 NPC</span></div><div id="npcs" class="list"></div></div></section>
</div><nav class="tabs"><button class="tab active" data-view="garden">🌷花园</button><button class="tab" data-view="world">🗺️世界</button><button class="tab" data-view="home">🏡家园</button><button class="tab" data-view="book">📖图鉴</button><button class="tab" data-view="explore">🔍探索</button></nav><div id="modal" class="modal"><div class="sheet"><button class="close" id="close">关闭</button><h2 id="modalTitle">✨</h2><div id="modalBody"></div></div></div><div id="toast" class="toast"></div>
<script>
const FLOWERS=[
 {id:'f1',name:'花芽',emoji:'🌱',lv:1,rarity:1,img:'assets/flower_1.png',tags:['basic']},{id:'f2',name:'嫩芽',emoji:'🌿',lv:2,rarity:1,img:'assets/flower_2.png',tags:['basic']},{id:'f3',name:'小雏菊',emoji:'🌼',lv:3,rarity:1,img:'assets/flower_3.png',tags:['basic']},{id:'f4',name:'郁金香',emoji:'🌷',lv:4,rarity:2,img:'assets/flower_4.png',tags:['basic']},{id:'f5',name:'玫瑰',emoji:'🌹',lv:5,rarity:2,img:'assets/flower_5.png',tags:['basic']},{id:'f6',name:'绣球花',emoji:'🌺',lv:6,rarity:3,img:'assets/flower_6.png',tags:['basic']},{id:'f7',name:'樱花',emoji:'🌸',lv:7,rarity:3,img:'assets/flower_7.png',tags:['basic']},{id:'f8',name:'水晶花',emoji:'💠',lv:8,rarity:4,img:'assets/flower_8.png',tags:['basic']},{id:'f9',name:'彩虹花',emoji:'🌈',lv:9,rarity:5,img:'assets/flower_9.png',tags:['legend']}
];
const SPECIAL=[
{id:'s1',name:'雨露玫瑰',emoji:'🫧',rarity:3,need:['f5','dew'],effect:'提高水系资源出现率'},
{id:'s2',name:'月影玫瑰',emoji:'🌙',rarity:3,need:['f5','moon'],effect:'夜晚更容易发现隐藏物'},
{id:'s3',name:'星辉玫瑰',emoji:'⭐',rarity:4,need:['f5','dust'],effect:'提高宝箱与稀有材料概率'},
{id:'s4',name:'幻彩玫瑰',emoji:'🌌',rarity:5,need:['f5','rainbow'],effect:'综合型特殊花'},
{id:'s5',name:'水晶郁金香',emoji:'💎',rarity:4,need:['f4','dew'],effect:'强化水域生态'},
{id:'s6',name:'月光郁金香',emoji:'🌙',rarity:3,need:['f4','moon'],effect:'吸引萤火虫'},
{id:'s7',name:'蜜香郁金香',emoji:'🍯',rarity:3,need:['f4','honey'],effect:'吸引蜜蜂'},
{id:'s8',name:'月樱',emoji:'🌙',rarity:4,need:['f7','moon'],effect:'开启夜间探索线索'},
{id:'s9',name:'蜜樱',emoji:'🍯',rarity:4,need:['f7','honey'],effect:'蝴蝶出现率提高'},
{id:'s10',name:'水晶绣球',emoji:'💎',rarity:4,need:['f6','dew'],effect:'强化大型水域生态'},
{id:'s11',name:'星辉郁金香',emoji:'⭐',rarity:4,need:['f4','dust'],effect:'提高星光探索收益'},
{id:'s12',name:'蜜香玫瑰',emoji:'🍯',rarity:4,need:['f5','honey'],effect:'提高蜜源生态'},
{id:'s13',name:'星樱',emoji:'⭐',rarity:5,need:['f7','dust'],effect:'提高夜间稀有发现'},
{id:'s14',name:'露珠月樱',emoji:'💧',rarity:5,need:['f7','dew'],effect:'水域与夜光共鸣'},
{id:'s15',name:'樱玫',emoji:'🌸',rarity:5,need:['f7','rose'],effect:'混合花香生态'},
{id:'s16',name:'月夜绣球',emoji:'🌙',rarity:5,need:['f6','moon'],effect:'吸引夜行生物'},
{id:'s17',name:'星云绣球',emoji:'🌌',rarity:5,need:['f6','dust'],effect:'提高星尘事件概率'},
{id:'s18',name:'生命绣球',emoji:'🌿',rarity:5,need:['f6','life'],effect:'提高植物生长速度'},
{id:'s19',name:'幻彩郁金香',emoji:'🌈',rarity:5,need:['f4','rainbow'],effect:'提高彩虹事件概率'},
{id:'s20',name:'星辉樱花',emoji:'✨',rarity:5,need:['f7','rainbow'],effect:'稀有变异概率提高'},
{id:'s21',name:'幻彩绣球',emoji:'🌈',rarity:5,need:['f6','rainbow'],effect:'综合生态加成'},
{id:'s22',name:'生命玫瑰',emoji:'🌿',rarity:4,need:['f5','life'],effect:'提高家园植物产出'},
{id:'s23',name:'冰晶绣球',emoji:'❄️',rarity:5,need:['f6','ice'],effect:'开启寒地探索线索'},
{id:'s24',name:'世界花',emoji:'🌟',rarity:6,need:['f9','seed'],effect:'终局世界资源'},
{id:'s25',name:'星之花',emoji:'⭐',rarity:6,need:['f9','dust'],effect:'终局星光生态核心'}
];
const ITEM_RULES={
 s1:{source:'玫瑰 + 水露；也可在雨天/水域探索中获得线索',use:'摆放到家园，建立水系花园',eco:{water:5,flower:3},likes:'青蛙、蝴蝶；偏好水域',time:'白天/雨天',combo:'与小池塘、喷泉搭配可提高水域共鸣',result:'水域值≥15时，水露资源出现率提高'},
 s2:{source:'玫瑰 + 月光；月光夜探索可发现线索',use:'打造夜光生态，吸引夜行生物',eco:{night:8,flower:3},likes:'萤火虫、月光蝶；偏好夜晚',time:'黄昏/夜晚',combo:'与月光灯、月樱搭配',result:'夜光值≥20时，夜间隐藏事件概率提高'},
 s3:{source:'玫瑰 + 星尘；流星雨/星路探索',use:'提高稀有探索与宝箱倾向',eco:{night:5,beauty:4},likes:'星光类生物；偏好夜晚',time:'夜晚/流星雨',combo:'与月光灯、彩虹花圃搭配',result:'有概率触发星尘事件'},
 s4:{source:'玫瑰 + 彩虹碎片；高阶探索',use:'打造混合彩虹生态',eco:{beauty:8,flower:6,water:2,forest:2,night:2,honey:2},likes:'多种稀有生物；偏好生态平衡',time:'全天/彩虹天气',combo:'与至少两种不同生态搭配',result:'提高稀有变异与彩虹事件概率'},
 s5:{source:'郁金香 + 水露；水域探索',use:'强化水域生态',eco:{water:7,flower:2},likes:'青蛙、水蝶',time:'白天/雨天',combo:'与小池塘/喷泉搭配',result:'水域资源产出提高'},

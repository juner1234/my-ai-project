const NPC_STORIES={
 '芽芽':['“我想让小镇的每个角落都开着花。”','“原来一朵小花，也能让人记住一个地方。”','“等我种出最特别的花，我一定第一时间告诉你。”'],
 '团团':['“我才没有偷吃蜂蜜……我只是帮它检查味道。”','“好吧，我承认，我真的很喜欢甜甜的东西。”','“下次我发现宝贝，一定先叫你。”'],
 '栗栗':['“森林里藏着很多东西，真正珍贵的不是金币。”','“有些宝箱，只有知道它故事的人才找得到。”','“你已经是我可以分享藏宝图的人了。”'],
 '星星':['“夜晚的花会听见白天听不到的声音。”','“月光不是普通材料，它会记住来过的人。”','“如果有一天看到星尘落在花瓣上，不要急着捡。”'],
 '花婆婆':['“这个小镇以前比现在热闹得多。”','“每一朵被留下的花，都是一段故事。”','“也许有一天，你会找到小镇最初的那颗种子。”']
};
